---
// The landing surface for the vaccination ad group. Everything here is
// config-driven: a clone without a `vaccines` block never renders this.
//
// The section id is the ad group's final URL (/#vacunas) — it is an external
// contract, not a styling choice. Don't rename it.
import { client } from "../config/client";
import Section from "./Section.astro";
import WhatsAppCta from "./WhatsAppCta.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const v = client.vaccines!;
---
{/* scroll-mt keeps the heading off the very top edge when traffic lands
    directly on the anchor. */}
<Section id={v.id} title={v.heading} class="scroll-mt-6">
  <p class="max-w-[38rem] text-lede">{v.blurb}</p>

  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {v.items.map((item) => (
      <li class="grid content-start gap-1.5 rounded-md border border-rule bg-white px-5 py-4">
        <span class="text-datum font-semibold">{item.name}</span>
        <span class="text-note leading-[1.5] text-muted">{item.desc}</span>
      </li>
    ))}
  </ul>

  <p class="mt-3.5 border-t border-rule pt-3.5 text-fine text-muted">{v.trust}</p>

  {/* Same pill as the hero and dock — only the prefill and the `cta` param
      differ, so vaccine taps are separable in GTM without a new event. */}
  <div class="mt-5">
    <WhatsAppCta label={v.cta} context="vacunas" prefill={v.prefill}>
      <WhatsAppIcon slot="icon" />
    </WhatsAppCta>
  </div>
</Section>
