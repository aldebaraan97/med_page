---
import { client } from "../config/client";
import Section from "./Section.astro";
---
<Section id="servicios" title="Servicios">
  <ul class="grid gap-0.5">
    {client.services.map((s) => (
      // A row only gets an id when an ad group deep-links to it (see Service
      // in client.ts). scroll-mt keeps it off the top edge on arrival.
      <li
        id={s.anchor}
        class:list={[
          "flex flex-wrap justify-between gap-x-4 gap-y-1 border-b border-rule py-3",
          s.anchor && "scroll-mt-6",
        ]}
      >
        <span class="font-semibold">{s.name}</span>
        <span class="text-[0.9rem] text-muted">{s.note}</span>
      </li>
    ))}
  </ul>
</Section>